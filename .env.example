# Environment Variables Example File
# Copy this file to .env.local and fill in the values before running the app.
# NEVER commit the real .env.local to version control!

# Google Gemini API Key (Required for AI Chat & Veracity Checking)
# Get this from: https://aistudio.google.com/
VITE_GEMINI_API_KEY="your_google_gemini_api_key_here"

# Firebase Project Configuration (Required for Analytics & Cloud Functions)
# Get these from your Firebase Project Settings > General > Web App
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="vote-mate-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="vote-mate-ai"
VITE_FIREBASE_STORAGE_BUCKET="vote-mate-ai.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id_here"
VITE_FIREBASE_APP_ID="your_app_id_here"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: Use Offline Mode strictly (for testing fallback)
# VITE_STRICT_OFFLINE_MODE="true"
